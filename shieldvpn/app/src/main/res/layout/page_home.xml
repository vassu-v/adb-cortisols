<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" style="@style/Sv.Page">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="20dp">

        <TextView android:text="ShieldVPN"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Sv.LabelMedium" />
        <TextView android:id="@+id/home_status" android:text="Off"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Sv.DisplayMedium" />
        <TextView android:id="@+id/home_sub" android:layout_marginTop="4dp"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Sv.BodyMedium" />

        <app.shieldvpn.PowerRingView android:id="@+id/power"
            android:layout_width="240dp" android:layout_height="240dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="24dp" android:layout_marginBottom="24dp"
            android:contentDescription="Toggle ad blocking" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal">
            <LinearLayout style="@style/Sv.Card" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:layout_marginEnd="6dp">
                <TextView android:text="Blocked today" android:textAppearance="@style/TextAppearance.Sv.LabelMedium"
                    android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <TextView android:id="@+id/stat_today" android:text="0" android:layout_marginTop="8dp"
                    android:textAppearance="@style/TextAppearance.Sv.HeadlineMedium"
                    android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>
            <LinearLayout style="@style/Sv.Card" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:layout_marginStart="6dp">
                <TextView android:text="Blocked total" android:textAppearance="@style/TextAppearance.Sv.LabelMedium"
                    android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <TextView android:id="@+id/stat_total" android:text="0" android:layout_marginTop="8dp"
                    android:textAppearance="@style/TextAppearance.Sv.HeadlineMedium"
                    android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginTop="12dp">
            <LinearLayout style="@style/Sv.Card" android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:layout_marginEnd="6dp">
                <TextView android:text="Lists updated" android:textAppearance="@style/TextAppearance.Sv.LabelMedium"
                    android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <TextView android:id="@+id/stat_updated" android:text="Never" android:layout_marginTop="8dp"
                    android:textAppearance="@style/TextAppearance.Sv.TitleLarge"
                    android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>
            <LinearLayout style="@style/Sv.Card" android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:layout_marginStart="6dp">
                <TextView android:text="Rules loaded" android:textAppearance="@style/TextAppearance.Sv.LabelMedium"
                    android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <TextView android:id="@+id/stat_rules" android:text="0" android:layout_marginTop="8dp"
                    android:textAppearance="@style/TextAppearance.Sv.TitleLarge"
                    android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
