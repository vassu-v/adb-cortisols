<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/sv_surface">

    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <include android:id="@+id/page_home" layout="@layout/page_home" />
        <include android:id="@+id/page_lists" layout="@layout/page_lists" />
        <include android:id="@+id/page_activity" layout="@layout/page_activity" />
        <include android:id="@+id/page_settings" layout="@layout/page_settings" />
    </FrameLayout>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/nav"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="@color/sv_surface_container"
        app:menu="@menu/nav"
        app:labelVisibilityMode="labeled"
        app:itemIconTint="@color/nav_item"
        app:itemTextColor="@color/nav_item" />
</LinearLayout>
