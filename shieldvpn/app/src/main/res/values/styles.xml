<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Material 3 type scale -->
    <style name="TextAppearance.Sv.DisplayMedium" parent="android:TextAppearance">
        <item name="android:textSize">45sp</item>
        <item name="android:fontFamily">sans-serif-light</item>
        <item name="android:textColor">@color/sv_on_surface</item>
    </style>
    <style name="TextAppearance.Sv.HeadlineMedium" parent="android:TextAppearance">
        <item name="android:textSize">28sp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/sv_on_surface</item>
    </style>
    <style name="TextAppearance.Sv.HeadlineSmall" parent="android:TextAppearance">
        <item name="android:textSize">24sp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/sv_on_surface</item>
    </style>
    <style name="TextAppearance.Sv.TitleLarge" parent="android:TextAppearance">
        <item name="android:textSize">22sp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/sv_on_surface</item>
    </style>
    <style name="TextAppearance.Sv.TitleMedium" parent="android:TextAppearance">
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:textColor">@color/sv_on_surface</item>
    </style>
    <style name="TextAppearance.Sv.LabelLarge" parent="android:TextAppearance">
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.007</item>
        <item name="android:textColor">@color/sv_on_surface</item>
    </style>
    <style name="TextAppearance.Sv.LabelMedium" parent="android:TextAppearance">
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/sv_on_surface_variant</item>
    </style>
    <style name="TextAppearance.Sv.BodyLarge" parent="android:TextAppearance">
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/sv_on_surface</item>
    </style>
    <style name="TextAppearance.Sv.BodyMedium" parent="android:TextAppearance">
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/sv_on_surface_variant</item>
    </style>

    <style name="Sv" />

    <style name="Sv.Page">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:clipToPadding">false</item>
        <item name="android:scrollbars">none</item>
        <item name="android:fillViewport">true</item>
    </style>
    <style name="Sv.Card">
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">16dp</item>
    </style>
    <style name="Sv.Divider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:background">@color/sv_outline_variant</item>
    </style>
    <style name="Sv.Button" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/sv_primary</item>
        <item name="android:textColor">@color/sv_on_primary</item>
        <item name="cornerRadius">24dp</item>
        <item name="android:minHeight">48dp</item>
    </style>
    <style name="Sv.Button.Tonal">
        <item name="backgroundTint">@color/sv_primary_container</item>
        <item name="android:textColor">@color/sv_on_primary_container</item>
    </style>
</resources>
